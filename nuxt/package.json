{
  "name": "nuxt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy": "nuxt build && wrangler --cwd .output deploy",
    "preview:cf": "wrangler --cwd .output dev",
    "postinstall": "nuxt prepare",
    "lint": "vp lint --type-aware . && eslint .",
    "lint:fix": "vp lint --type-aware . --fix --fix-suggestions && eslint . --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "nuxt": "^4.6.4",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.101",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/icon": "^2.6.3",
    "@types/node": "^25.9.9",
    "eslint": "^10.15.0",
    "eslint-plugin-oxlint": "^1.94.0",
    "rolldown": "~1.2.19",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:",
    "wrangler": "^4.164.0"
  },
  "packageManager": "pnpm@11.17.0"
}
